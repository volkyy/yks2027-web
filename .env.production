# YKS2027 WEB - Production Environment Variables
# Bu dosya production sunucu için yapılandırılmıştır
# GÜVENLİK: Bu dosyayı .gitignore'a ekleyin!
#
# Multi-User Support Configuration:
# - Redis session storage
# - Redis caching
# - Database connection pooling
# - Rate limiting

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=BU_RASTGELE_GUVENLI_BIR_SECRET_KEY_ILE_DEGISTIRIN_xyz789!@#

# Database Configuration
# Production PostgreSQL veritabanı
# Docker kullanıyorsanız: postgresql://yks2027_user:password@db:5432/yks2027
DATABASE_URL=postgresql://yks2027_user:SECURE_PASSWORD_HERE@localhost:5432/yks2027

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Security - Production Settings
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# Rate Limiting (brute-force koruması)
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_STORAGE_URL=redis://localhost:6379/0

# Redis Configuration (REQUIRED for multi-user support)
# Session storage ve caching için kullanılır
# Docker kullanıyorsanız: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Database Connection Pooling (SQLAlchemy)
# Multi-user ortamında performans için önemli
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_MAX_OVERFLOW=40
SQLALCHEMY_POOL_RECYCLE=3600

# Waitress Server Configuration
WAITRESS_THREADS=8

# Sentry Monitoring (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# CORS (if needed for API)
# CORS_ORIGINS=https://yourdomain.com

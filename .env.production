# YKS2027 WEB - Production Environment Variables
# Bu dosya production sunucu için yapılandırılmıştır
# GÜVENLİK: Bu dosyayı .gitignore'a ekleyin!

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=BU_RASTGELE_GUVENLI_BIR_SECRET_KEY_ILE_DEGISTIRIN_xyz789!@#

# Database Configuration
# Production PostgreSQL veritabanı
# DATABASE_URL=postgresql://username:password@host:5432/yks2027
DATABASE_URL=postgresql://yks2027_user:SECURE_PASSWORD_HERE@localhost:5432/yks2027

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Security - Production Settings
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# Rate Limiting
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_STORAGE_URL=redis://localhost:6379/0

# Sentry Monitoring
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# Redis (for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0

# CORS (if needed for API)
# CORS_ORIGINS=https://yourdomain.com

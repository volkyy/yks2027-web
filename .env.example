# YKS2027 WEB Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri düzenleyin

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=yksi2027-gizli-anahtar-kelime-buraya

# Database Configuration
# SQLite için:
DATABASE_URL=sqlite:///yks2027.db

# PostgreSQL için (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/yks2027

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Email Configuration (Optional - for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Security
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
PERMANENT_SESSION_LIFETIME=3600

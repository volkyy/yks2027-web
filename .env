# YKS2027 WEB Environment Variables
# Bu dosya yerel geliştirme için yapılandırılmıştır

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=yksi2027-gizli-anahtar-kelime-buraya-degistirin-xyz123!

# Database Configuration
# Desktop uygulama ile aynı database'i kullanmak için:
# Windows: C:\Users\YOUR_USER\AppData\YKS2027\yks2027.db
# Veya merkezi bir konum belirleyin

# SQLite için (yerel) - instance klasöründe
DATABASE_URL=sqlite:///C:/AI PROJECTS/YKS2027_WEB/instance/yks2027.db

# Desktop uygulama veritabanını kullanmak için (örnek):
# DATABASE_URL=sqlite:///C:/Users/volkan.m/AppData/Roaming/YKS2027/yks2027.db
# DATABASE_URL=sqlite:///C:/Users/YOUR_USERNAME/AppData/Roaming/YKS2027/yks2027.db

# PostgreSQL için (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/yks2027

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Email Configuration (Optional - for notifications)
# Gmail için App Password kullanın (2FA aktif olmalı)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_USE_TLS=True

# Security
# Production'da SESSION_COOKIE_SECURE=True yapılmalı (HTTPS gerektirir)
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# Rate Limiting
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_STORAGE_URL=memory://

# Sentry Monitoring (Optional)
# SENTRY_DSN=
